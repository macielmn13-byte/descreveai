# =====================================================================
#  ContaGestão – Soluções Inteligentes · variáveis de ambiente
#  Copie para .env e preencha.  Gere as chaves com:  npm run gerar-chaves
#  NUNCA envie o arquivo .env para o Git.
# =====================================================================

# ----------------------------------------------------------- Aplicação
# development | test | production
NODE_ENV=development
APP_NAME=ContaGestão – Soluções Inteligentes
PORT=8000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# true = logs coloridos no terminal (somente desenvolvimento)
LOG_PRETTY=false
# Origens liberadas para navegador (ex.: https://app.suaempresa.com.br), separadas por vírgula
CORS_ORIGINS=
# URL base da API para o frontend. Vazio usa a mesma origem (proxy do Vite em desenvolvimento).
VITE_API_BASE_URL=
# true quando estiver atrás de Nginx/Load balancer (IP real do cliente)
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=120

# ----------------------------------------------------------- Segurança
# Chaves de API aceitas no cabeçalho X-API-Key (32+ caracteres; separe várias por vírgula)
API_KEYS=
# Chaves de criptografia AES-256 (base64 de 32 bytes). A 1ª criptografa; as demais só leem (rotação).
# ATENÇÃO: perder esta chave = perder o acesso aos documentos armazenados.
ENCRYPTION_KEYS=
# Token exigido no webhook de e-mail (cabeçalho X-Webhook-Token ou ?token=)
EMAIL_WEBHOOK_SECRET=

# ----------------------------------------------------- Banco de dados
# Desenvolvimento: sqlite:./data/contagestao.db
# Produção:        postgres://contagestao:SENHA@db:5432/contagestao
DATABASE_URL=sqlite:./data/contagestao.db
DB_POOL_MAX=10
# Aplica migrações ao iniciar (produção: false — o serviço "migrate" faz isso)
DB_AUTO_MIGRATE=true
# Usado pelo docker-compose para criar o banco PostgreSQL
POSTGRES_PASSWORD=

# --------------------------------------------------------------- Fila
# inline = processa na própria requisição (dev, sem Redis)
# bullmq = fila no Redis + worker separado (OBRIGATÓRIO em produção)
QUEUE_MODE=inline
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=900

# ------------------------------------------------------ Armazenamento
# local | s3   (S3, MinIO, Wasabi, Cloudflare R2...)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage
S3_BUCKET=
S3_PREFIX=documentos/
# Preencha apenas para provedores compatíveis (MinIO/R2/Wasabi)
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false
AWS_REGION=sa-east-1
# Credenciais AWS (S3/Textract). Em servidores AWS prefira IAM Role e deixe vazio.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------- Upload
MAX_UPLOAD_MB=25
MAX_PAGES=50
MAX_FILES_PER_EMAIL=10
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tif,tiff

# ---------------------------------------------------------------- OCR
# tesseract | textract
OCR_ENGINE=tesseract
TESSERACT_CMD=tesseract
TESSERACT_LANG=por+eng
TESSERACT_PSM=3
OCR_DPI=300
OCR_AUTO_ROTATE=true
ENHANCE_BINARIZE=false
# PDFs com pelo menos N caracteres de texto embutido por página pulam o OCR
NATIVE_TEXT_MIN_CHARS=80

# ---------------------------------------------------------------- LLM
# anthropic | openai | azure | none (none = extração por regras, sem custo)
LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_MAX_INPUT_CHARS=60000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# -------------------------------------------- Integrações (ERP / CRM)
# URLs que recebem o resultado de cada documento (separadas por vírgula)
WEBHOOK_URLS=
# Segredo da assinatura HMAC (obrigatório se WEBHOOK_URLS estiver preenchido)
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=15
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BASE_MS=1000

# ------------------------------------------- Docker (somente compose)
# Porta da API no modo docker:up (desenvolvimento)
API_PORT=8000
# Número de workers em produção (docker-compose.prod.yml)
WORKER_REPLICAS=1
# Imagem a usar (o deploy automático preenche com a do GHCR)
IMAGE=contagestao:latest
